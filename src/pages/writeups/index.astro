---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getAllWriteups } from '../../lib/writeups';

const writeups = await getAllWriteups();
const platforms = ['Todos', ...new Set(writeups.map((w: any) => w.data.platform).filter(Boolean))];
---

<Layout title="Writeups | Etern4l" description="Writeups de CTFs, máquinas y seguridad ofensiva.">
  <Navbar />
  <main class="pt-24 pb-24 min-h-screen">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Header -->
      <div class="mb-14">
        <a href="/" style="font-family:'Fira Code',monospace;font-size:0.78rem;color:#64748b;text-decoration:none;display:inline-flex;align-items:center;gap:6px;margin-bottom:24px;" onmouseover="this.style.color='#a78bfa'" onmouseout="this.style.color='#64748b'">
          ← Inicio
        </a>
        <p class="section-label mb-3">// bitácora técnica</p>
        <h1 class="text-3xl font-bold" style="font-family:'Inter',sans-serif;color:#e2e8f0;">
          Writeups
        </h1>
        <div class="mt-3 h-px w-16" style="background:linear-gradient(90deg,#8b5cf6,transparent);"></div>
        <p style="color:#64748b;font-size:0.88rem;margin-top:12px;">
          Writeups de CTFs que reflejan las habilidades y el conocimiento adquirido.
        </p>
      </div>

      <!-- Filters -->
      <div class="flex gap-2 flex-wrap mb-8" id="filter-buttons">
        {platforms.map((p: string, i: number) => (
          <button
            type="button"
            data-filter={p === 'Todos' ? 'all' : p}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="filter-btn"
            style={i === 0 ? 'border-color:rgba(139,92,246,0.5);color:#a78bfa;background:rgba(139,92,246,0.1);' : ''}
          >
            {p}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div id="writeups-container" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {writeups.map((wp: any) => (
          <a
            href={wp.href}
            class="glass-card p-6 writeup-item group"
            style="text-decoration:none;display:block;"
            data-platform={wp.data.platform ?? ''}
            data-text={[wp.data.title, wp.data.description, (wp.data.tags ?? []).join(' '), wp.data.platform].join(' ').toLowerCase()}
          >
            <p style="font-family:'Fira Code',monospace;font-size:0.68rem;color:#a78bfa;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.08em;">
              {wp.data.platform ?? 'CTF'}
            </p>
            <h2 class="font-semibold mb-2" style="color:#e2e8f0;font-size:1rem;line-height:1.4;">
              {wp.data.title}
            </h2>
            <p style="font-size:0.82rem;color:#64748b;line-height:1.6;margin-bottom:14px;">
              {wp.data.description ?? ''}
            </p>
            <div class="flex flex-wrap gap-2 mb-3">
              {(wp.data.tags ?? []).slice(0, 4).map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <p style="font-family:'Fira Code',monospace;font-size:0.68rem;color:#475569;">
              {new Date(wp.data.publishDate).toLocaleDateString('es-ES', {year:'numeric',month:'short',day:'numeric'})}
            </p>
          </a>
        ))}
      </div>

      <div id="no-results" class="hidden text-center py-16" style="color:#64748b;font-family:'Fira Code',monospace;font-size:0.85rem;">
        No se encontraron writeups.
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .filter-btn {
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
    color: #64748b;
    background: transparent;
    border: 1px solid rgba(100,116,139,0.2);
    padding: 6px 16px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-btn:hover {
    color: #a78bfa;
    border-color: rgba(139,92,246,0.3);
  }
</style>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.writeup-item');
  const noResults = document.getElementById('no-results');

  let activeFilter = 'all';

  function applyFilters() {
    let count = 0;
    items.forEach(item => {
      const platform = item.getAttribute('data-platform') || '';
      const matches = activeFilter === 'all' || platform === activeFilter;
      (item as HTMLElement).style.display = matches ? '' : 'none';
      if (matches) count++;
    });
    noResults?.classList.toggle('hidden', count !== 0);
  }

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => {
        b.setAttribute('aria-pressed', 'false');
        b.style.cssText = '';
      });
      btn.setAttribute('aria-pressed', 'true');
      btn.style.cssText = 'border-color:rgba(139,92,246,0.5);color:#a78bfa;background:rgba(139,92,246,0.1);';
      activeFilter = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });
</script>
