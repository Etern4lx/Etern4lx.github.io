---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { getPdfItems } from '../../../lib/writeups';

export function getStaticPaths() {
  return getPdfItems().map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
const formattedDate = new Intl.DateTimeFormat('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }).format(data.publishDate);
---

<Layout title={`${data.title} | Etern4l`} description={data.description}>
  <Navbar />
  <div class="max-w-5xl mx-auto px-6 py-24">
    <a href="/writeups" class="back">← Volver a Writeups</a>

    <header class="mb-8 pb-6" style="border-bottom:1px solid rgba(139,92,246,0.15);">
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="chip" style="color:#a78bfa;background:rgba(139,92,246,0.1);border-color:rgba(139,92,246,0.25);">{data.platform}</span>
        <span class="chip" style="color:#f59e0b;background:rgba(245,158,11,0.08);border-color:rgba(245,158,11,0.2);">{data.difficulty}</span>
        <span class="chip" style="color:#22d3ee;background:rgba(34,211,238,0.08);border-color:rgba(34,211,238,0.2);">{data.os}</span>
        <span class="chip" style="color:#f472b6;background:rgba(244,114,182,0.08);border-color:rgba(244,114,182,0.2);">PDF</span>
      </div>
      <h1 style="font-size:1.8rem;font-weight:700;color:#e2e8f0;line-height:1.3;margin-bottom:10px;">{data.title}</h1>
      <p style="color:#64748b;font-size:0.9rem;line-height:1.6;margin-bottom:16px;">{data.description}</p>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <span style="font-family:'Fira Code',monospace;font-size:0.72rem;color:#475569;">
          Publicado: <span style="color:#a78bfa;">{formattedDate}</span>
        </span>
        <div class="flex gap-3">
          <a href={item.pdfUrl} target="_blank" rel="noopener" class="btn-neon">Abrir en pestaña ↗</a>
          <a href={item.pdfUrl} download class="btn-solid">Descargar PDF</a>
        </div>
      </div>
    </header>

    <!-- Visor PDF integrado -->
    <div class="glass-card" style="padding:0;overflow:hidden;position:relative;z-index:2;">
      <iframe
        src={`${item.pdfUrl}#view=FitH`}
        title={data.title}
        style="width:100%;height:85vh;border:0;background:#1a1a2e;display:block;"
        loading="lazy"
      ></iframe>
    </div>
    <p style="font-family:'Fira Code',monospace;font-size:0.72rem;color:#475569;margin-top:12px;">
      ¿No se ve el visor? <a href={item.pdfUrl} target="_blank" style="color:#a78bfa;">Ábrelo directamente</a>.
    </p>
  </div>
  <Footer />
</Layout>

<style>
  .back {
    font-family: 'Fira Code', monospace;
    font-size: 0.78rem;
    color: #64748b;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 24px;
    transition: color 0.2s;
  }
  .back:hover { color: #a78bfa; }
  .chip {
    font-family: 'Fira Code', monospace;
    font-size: 0.72rem;
    border: 1px solid;
    padding: 3px 10px;
    border-radius: 4px;
  }
</style>
