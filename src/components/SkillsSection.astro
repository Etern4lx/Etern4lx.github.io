---
const skills = [
  { category: 'Pentesting', items: ['Nmap', 'Metasploit', 'Burp Suite', 'SQLMap'] },
  { category: 'Red Team', items: ['BloodHound', 'Impacket', 'CrackMapExec', 'Responder', 'Mimikatz'] },
  { category: 'Web', items: ['OWASP Top 10', 'XSS', 'SQLi', 'SSRF', 'XXE'] },
  { category: 'Scripting', items: ['Python', 'Bash', 'PowerShell'] },
  { category: 'Plataformas', items: ['HackTheBox', 'TryHackMe', 'INE', 'VulnHub'] },
  { category: 'Sistemas', items: ['Linux', 'Windows'] },
];
---

<section id="arsenal" class="relative py-24">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="mb-14">
      <p class="section-label mb-3">// herramientas y conocimientos</p>
      <h2 class="text-3xl font-bold" style="font-family:'Inter',sans-serif;color:#e2e8f0;">
        Arsenal
      </h2>
      <div class="mt-3 h-px w-16" style="background:linear-gradient(90deg,#8b5cf6,transparent);"></div>
    </div>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {skills.map(group => (
        <div class="glass-card p-6">
          <h3 style="font-family:'Fira Code',monospace;font-size:0.8rem;color:#a78bfa;margin-bottom:14px;letter-spacing:0.05em;">
            {group.category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item: string) => (
              <span style="font-family:'Fira Code',monospace;font-size:0.72rem;color:#94a3b8;background:rgba(148,163,184,0.06);border:1px solid rgba(148,163,184,0.12);padding:3px 10px;border-radius:4px;">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
