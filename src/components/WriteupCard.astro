---
interface Props {
  writeup: any;
}
const { writeup } = Astro.props;
const { data } = writeup;
const dateStr = data.publishDate ?? data.date;
---

<a
  href={`/writeups/${writeup.id}`}
  class="glass-card p-6 group block"
  style="text-decoration:none;"
>
  <p style="font-family:'Fira Code',monospace;font-size:0.68rem;color:#a78bfa;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.08em;">
    {data.platform ?? 'CTF'}
  </p>
  <h3 style="color:#e2e8f0;font-size:1rem;font-weight:600;line-height:1.4;margin-bottom:8px;">
    {data.title}
  </h3>
  <p style="font-size:0.82rem;color:#64748b;line-height:1.6;margin-bottom:14px;">
    {data.description ?? ''}
  </p>
  <div class="flex flex-wrap gap-2 mb-3">
    {(data.tags ?? []).slice(0, 3).map((tag: string) => (
      <span class="tag">{tag}</span>
    ))}
  </div>
  {dateStr && (
    <p style="font-family:'Fira Code',monospace;font-size:0.68rem;color:#475569;">
      {new Date(dateStr).toLocaleDateString('es-ES', {year:'numeric',month:'short',day:'numeric'})}
    </p>
  )}
</a>
