---
import community from '../data/community.json';
---

<section id="comunidad" class="relative py-24">
  <!-- Ambient -->
  <div class="ambient-orb" style="width:300px;height:300px;background:rgba(88,28,135,0.12);bottom:0;left:-80px;"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="mb-14">
      <p class="section-label mb-3">// únete al movimiento</p>
      <h2 class="text-3xl font-bold" style="font-family:'Inter',sans-serif;color:#e2e8f0;">
        Comunidad
      </h2>
      <div class="mt-3 h-px w-16" style="background:linear-gradient(90deg,#8b5cf6,transparent);"></div>
    </div>

    <!-- Main card -->
    <div class="glass-card p-10 relative overflow-hidden glow-purple-sm">
      <!-- Decorative corner -->
      <div style="position:absolute;top:0;right:0;width:200px;height:200px;background:radial-gradient(circle at 100% 0%,rgba(139,92,246,0.15),transparent 70%);pointer-events:none;"></div>

      <div class="grid lg:grid-cols-2 gap-10 items-center relative z-10">
        <!-- Left -->
        <div>
          <div class="flex items-center gap-3 mb-5">
            <img
              src="/stickybit.png"
              alt="StickyBit"
              width="44"
              height="44"
              style="width:44px;height:44px;border-radius:10px;box-shadow:0 0 14px rgba(139,92,246,0.35);"
            />
            <div>
              <h3 style="font-size:1.3rem;font-weight:700;color:#e2e8f0;">StickyBit</h3>
              <p style="font-family:'Fira Code',monospace;font-size:0.72rem;color:#f59e0b;">
                EARLY ACCESS
              </p>
            </div>
          </div>

          <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;margin-bottom:6px;">
            Comunidad de ciberseguridad en español. CTFs, metodologías,
            recursos y una red de hackers que se ayudan mutuamente.
          </p>
          <p style="font-family:'Fira Code',monospace;font-size:0.78rem;color:#64748b;margin-bottom:24px;">
            // en construcción · pronto disponible
          </p>

          <div class="flex gap-4 flex-wrap items-center">
            <a
              href={community.websiteUrl || 'https://www.stickybit.es'}
              target="_blank"
              rel="noopener"
              class="btn-solid"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              Visitar Web
            </a>

            <a
              href={community.discordUrl}
              target="_blank"
              rel="noopener"
              class="btn-neon"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.057a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
              </svg>
              Unirse al Discord
            </a>
          </div>
        </div>

        <!-- Right: stats -->
        <div class="grid grid-cols-2 gap-4">
          {[
            { icon: '🛡', label: 'Comunidad', value: 'En construcción' },
            { icon: '📡', label: 'Discord', value: 'Activo' },
            { icon: '📝', label: 'Writeups', value: 'Creciendo' },
            { icon: '🔐', label: 'CTFs', value: 'Próximamente' },
          ].map(item => (
            <div class="glass-card p-4 text-center" style="background:rgba(10,10,15,0.5);">
              <div style="font-size:1.4rem;margin-bottom:6px;">{item.icon}</div>
              <div style="font-family:'Fira Code',monospace;font-size:0.82rem;color:#a78bfa;font-weight:600;">{item.value}</div>
              <div style="font-size:0.72rem;color:#64748b;margin-top:2px;">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
